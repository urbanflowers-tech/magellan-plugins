{
  "type": "object",
  "properties": {
    "results": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "body_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "status": {
            "enum": [
              "accepted",
              "duplicate",
              "retry",
              "rejected",
              "payload_conflict"
            ]
          },
          "receipt_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256
          },
          "received_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "code": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256
          }
        },
        "required": [
          "event_id",
          "body_hash",
          "status",
          "receipt_id",
          "received_at",
          "code"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "results"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
